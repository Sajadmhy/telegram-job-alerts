# Copy this file to .env and fill it in.

# 1) From https://my.telegram.org -> API development tools (create any app name)
TG_API_ID=
TG_API_HASH=

# 2) From @BotFather -> /newbot
BOT_TOKEN=
# 3) Run `python job_alert.py chat-id` after sending your bot a message
NOTIFY_CHAT_ID=

# Chat to discover channels from (name or @username)
SOURCE_CHAT=
DISCOVER_LIMIT=200

# How often to check the channels, and how picky the filter is (higher = stricter)
POLL_MINUTES=5
MIN_SCORE=2
# Flood guards: skip posts older than this, and cap alerts per check
MAX_AGE_HOURS=6
MAX_ALERTS_PER_POLL=10

# Optional, if Telegram needs a proxy on your network, e.g. socks5://127.0.0.1:1080
PROXY=

# Resume tailoring (the `unemployed` backend, see tailor_bot.py). Empty RESUME_API turns it off.
RESUME_API=http://localhost:8000
RESUME_TIMEOUT_MIN=20
